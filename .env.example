# Proveedor Gemini
GEMINI_API_KEY=reemplazar_con_api_key
GEM_BASE=https://generativelanguage.googleapis.com/v1beta/openai/
DEFAULT_GEMINI_MODEL=gemini-3.8-flash

# Recuperación
COLLECTION=kb_docs
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
DEFAULT_TOP_K=6
DEFAULT_PROVIDER=gemini

# Procesamiento
ENABLE_WATCHER=false
ENABLE_RERANKER=true
RERANKER_MODEL=BAAI/bge-reranker-base

# Open WebUI
# Generate a strong random secret key for session signing.
# Example:  python -c "import secrets; print(secrets.token_urlsafe(48))"
WEBUI_SECRET_KEY=CHANGE_ME_generate_a_random_secret
