# ============================ Modo de LLM ============================
# ollama = todo local y sin costo (texto + agente de imagen en Ollama).
# gemini = de pago (texto en Gemini con respaldo en Ollama; agente gemini_native).
DEFAULT_PROVIDER=ollama

# ---- Ollama (modo local) ----
# Perfiles orientativos (ver docs/local-providers.md):
#   PC 4 GB VRAM o CPU : OLLAMA_DEFAULT_MODEL=qwen2.5:3b   OLLAMA_KEEP_ALIVE=1m
#   Servidor 20 GB VRAM: OLLAMA_DEFAULT_MODEL=qwen2.5:14b  OLLAMA_KEEP_ALIVE=30m
# Descargar antes el modelo:  docker exec ollama ollama pull qwen2.5:3b
OLLAMA_DEFAULT_MODEL=qwen2.5:3b
OLLAMA_KEEP_ALIVE=5m
# Contenedor (por defecto) o Ollama nativo de Windows: http://host.docker.internal:11434
OLLAMA_BASE_URL=http://ollama:11434
# Límite por ronda del agente de imagen; en una GPU de 4 GB una ronda puede tardar minutos.
OLLAMA_TIMEOUT_SECONDS=300
# Ventana de contexto. El valor por defecto de Ollama (4096) no cabe con la evidencia
# y hace que el modelo entre en bucle. 8192 sirve en 4 GB; en 20 GB puede ser 16384.
OLLAMA_NUM_CTX=8192
# Tope de tokens de salida por ronda del agente de imagen (corta salidas desbocadas).
OLLAMA_MAX_OUTPUT_TOKENS=1024

# ---- Gemini (solo modo gemini; en modo local puede quedar vacía) ----
GEMINI_API_KEY=
GEM_BASE=https://generativelanguage.googleapis.com/v1beta/openai/
DEFAULT_GEMINI_MODEL=gemini-3.8-flash

# Recuperación
COLLECTION=kb_docs
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
DEFAULT_TOP_K=6

# Procesamiento
ENABLE_WATCHER=false
ENABLE_RERANKER=true
# BM25 vive en memoria: se construye al arrancar y tras cada /ingest.
ENABLE_BM25_AUTOBUILD=true
# Máximo de fragmentos en el índice léxico (0 = sin límite). Se avisa en el log al alcanzarlo.
BM25_CAP=50000
RERANKER_MODEL=BAAI/bge-reranker-base

# Open WebUI
# Generate a strong random secret key for session signing.
# Example:  python -c "import secrets; print(secrets.token_urlsafe(48))"
WEBUI_SECRET_KEY=CHANGE_ME_generate_a_random_secret
# Nombre visible de la interfaz.
WEBUI_NAME=Open WebUI
# Motor de imagen inicial de Open WebUI (solo primer arranque; luego Admin → Images).
#   modo local : comfyui (o automatic1111), corriendo nativo en Windows
#   modo gemini: gemini
OPENWEBUI_IMAGE_ENGINE=comfyui
COMFYUI_BASE_URL=http://host.docker.internal:8188
AUTOMATIC1111_BASE_URL=http://host.docker.internal:7860

# Generación de imágenes contextualizada (contrato inactivo y denegado por defecto).
# No habilitar hasta aprobar TODOS los gates del runbook de README.md. La
# configuración actual es NO-GO y no compone el flujo de imágenes en producción.
GROUNDED_IMAGE_ENABLED=false
# Shadow: mide intención/recuperación sin llamar a proveedores ni emitir tools.
# Mutuamente excluyente con GROUNDED_IMAGE_ENABLED=true.
GROUNDED_IMAGE_SHADOW=false
GROUNDED_IMAGE_TRUSTED_BOUNDARY=false
GROUNDED_IMAGE_PROVENANCE_ENABLED=false
# Agente que redacta la instrucción y emite generate_image. Vacío = según DEFAULT_PROVIDER
# (ollama -> ollama, gemini -> gemini_native). No activa el flujo por sí mismo.
GROUNDED_IMAGE_ADAPTER=
# Listas separadas por comas, sin espacios ni duplicados. Mantener vacías en rollback.
GROUNDED_IMAGE_AUTHORIZED_USERS=
GROUNDED_IMAGE_AUTHORIZED_MODELS=
# Límites normativos. TTL, packet bytes y tool iterations no se pueden relajar.
GROUNDED_IMAGE_MIN_REFERENCES=2
# Fracción (0, 1] de términos del tema que debe mencionar un fragmento para contar
# como evidencia; además, cada término debe aparecer en alguna evidencia.
GROUNDED_IMAGE_MIN_SUBJECT_COVERAGE=0.5
GROUNDED_IMAGE_CORRELATION_TTL_SECONDS=600
GROUNDED_IMAGE_CORRELATION_MAX_ENTRIES=1024
GROUNDED_IMAGE_CORRELATION_MAX_PACKET_BYTES=262144
GROUNDED_IMAGE_CORRELATION_MAX_IDENTIFIER_BYTES=1024
GROUNDED_IMAGE_MAX_TOOL_ITERATIONS=3
# Sigue siendo 1: el despliegue multi-réplica es NO-GO hasta aprobar el spike Redis.
GROUNDED_IMAGE_REPLICA_COUNT=1
# Modelo del agente de imagen. Vacío = OLLAMA_DEFAULT_MODEL (local) o DEFAULT_GEMINI_MODEL.
GROUNDED_IMAGE_CHAT_MODEL=
# ID público del motor de imagen configurado en Open WebUI (solo para procedencia),
# p. ej. comfyui-sd15 (PC 4 GB), comfyui-sdxl o comfyui-flux-schnell (servidor 20 GB).
GROUNDED_IMAGE_IMAGE_MODEL_ID=open-webui-image-engine
# Prompt que recibe el motor de imagen. Vacío = según DEFAULT_PROVIDER.
#   diffusion     : frase corta en inglés con los hechos documentados (ComfyUI/A1111, CLIP).
#   canonical_json: instrucción canónica completa (motores tipo LLM, como Gemini).
GROUNDED_IMAGE_PROMPT_FORMAT=
# message: usuario+chat+X-OpenWebUI-Message-Id (estricto).
# chat: usuario+chat+hash del último mensaje, si Open WebUI no envía Message-Id.
GROUNDED_IMAGE_CORRELATION_SCOPE=message
# Open WebUI: reenviar encabezados de identidad al backend (necesario para imagen).
OPENWEBUI_FORWARD_USER_INFO_HEADERS=false

# Credenciales independientes de correlación. Dejar vacías mientras esté deshabilitado.
# Inyectar mediante el gestor de secretos del despliegue, nunca en Git, logs o exports.
# Generar valores nuevos; nunca reutilizar WEBUI_SECRET_KEY ni GEMINI_API_KEY.
# RAG_TRUSTED_SERVICE_TOKEN: 32-512 bytes imprimibles, sin espacios.
# RAG_CORRELATION_HMAC_KEY: 32-128 bytes aleatorios codificados como base64url.
RAG_TRUSTED_SERVICE_TOKEN=
RAG_CORRELATION_HMAC_KEY=
